{
  "info": {
    "name": "Restful-Booker - Pruebas automatizadas (práctica QA)",
    "description": "Colección de práctica sobre https://restful-booker.herokuapp.com. Incluye healthcheck, auth, flujo CRUD encadenado, casos negativos, casos de borde y limpieza. Correr en orden (Collection Runner o newman).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Validaciones comunes a TODOS los requests",
          "pm.test('[común] Tiempo de respuesta < ' + pm.environment.get('maxResponseMs') + ' ms', function () {",
          "pm.expect(pm.response.responseTime).to.be.below(Number(pm.environment.get('maxResponseMs') || 3000));",
          "});",
          "pm.test('[común] No devuelve 5xx inesperado', function () {",
          "// Los requests que esperan 500 a propósito marcan expect500=true en su pre-request",
          "if (pm.environment.get('expect500') === 'true') { pm.environment.unset('expect500'); return; }",
          "pm.expect(pm.response.code, 'status').to.be.below(500);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Healthcheck",
      "item": [
        {
          "name": "TC-01 Ping - la API está viva",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "TC-02 Auth con credenciales válidas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve un token no vacío', () => {",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token).to.be.a('string').and.not.empty;",
                  "});",
                  "// Encadenamiento: el token se usa en PUT/PATCH/DELETE",
                  "pm.environment.set('token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-03 Auth con password incorrecta (negativo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"incorrecta\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nota QA: la API responde 200 con un \"reason\" en vez de 401. Se documenta como observación.",
                  "pm.test('No devuelve token', () => pm.expect(pm.response.json()).to.not.have.property('token'));",
                  "pm.test('Mensaje \"Bad credentials\"', () => pm.expect(pm.response.json().reason).to.eql('Bad credentials'));"
                ]
              }
            }
          ]
