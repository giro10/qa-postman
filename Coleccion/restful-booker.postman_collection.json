    {
      "name": "02 - Booking CRUD (flujo encadenado)",
      "description": "Flujo E2E: crear → consultar → buscar → actualizar → actualizar parcial → borrar → verificar borrado. Cada paso usa el bookingid guardado por el anterior.",
      "item": [
        {
          "name": "TC-05 Crear booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{firstname}}\",\n  \"lastname\": \"{{lastname}}\",\n  \"totalprice\": {{totalprice}},\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"{{checkin}}\",\n    \"checkout\": \"{{checkout}}\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Datos de prueba dinámicos: cada corrida usa un nombre único",
                  "const suffix = Date.now().toString().slice(-6);",
                  "pm.environment.set('firstname', 'QA' + suffix);",
                  "pm.environment.set('lastname', 'Tester');",
                  "pm.environment.set('totalprice', 150);",
                  "const today = new Date();",
                  "const plus = (d) => new Date(today.getTime() + d * 86400000).toISOString().slice(0, 10);",
                  "pm.environment.set('checkin', plus(10));",
                  "pm.environment.set('checkout', plus(15));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type JSON', () => pm.response.to.have.header('Content-Type'));",
                  "const json = pm.response.json();",
                  "pm.test('Devuelve bookingid numérico', () => pm.expect(json.bookingid).to.be.a('number'));",
                  "pm.test('El booking cumple el schema', () => pm.response.to.have.jsonSchema({",
                  "    type: 'object', required: ['bookingid', 'booking'],",
                  "    properties: { bookingid: { type: 'number' }, booking: {\"type\":\"object\",\"required\":[\"firstname\",\"lastname\",\"totalprice\",\"depositpaid\",\"bookingdates\"],\"properties\":{\"firstname\":{\"type\":\"string\"},\"lastname\":{\"type\":\"string\"},\"totalprice\":{\"type\":\"number\"},\"depositpaid\":{\"type\":\"boolean\"},\"bookingdates\":{\"type\":\"object\",\"required\":[\"checkin\",\"checkout\"],\"properties\":{\"checkin\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"},\"checkout\":{\"type\":\"string\",\"pattern\":\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"}}},\"additionalneeds\":{\"type\":\"string\"}}} }",
                  "}));",
                  "pm.test('Los datos guardados coinciden con los enviados', () => {",
                  "    const b = json.booking;",
                  "    pm.expect(b.firstname).to.eql(pm.environment.get('firstname'));",
                  "    pm.expect(b.lastname).to.eql(pm.environment.get('lastname'));",
                  "    pm.expect(b.totalprice).to.eql(Number(pm.environment.get('totalprice')));",
                  "    pm.expect(b.bookingdates.checkin).to.eql(pm.environment.get('checkin'));",
                  "    pm.expect(b.bookingdates.checkout).to.eql(pm.environment.get('checkout'));",
                  "});",
                  "pm.environment.set('bookingId', json.bookingid);"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-06 Obtener booking por id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Persistió con el nombre correcto', () => {",
                  "    pm.expect(pm.response.json().firstname).to.eql(pm.environment.get('firstname'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-07 Buscar bookings por nombre (filtro)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname={{firstname}}&lastname={{lastname}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "{{firstname}}"
                },
                {
                  "key": "lastname",
                  "value": "{{lastname}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().map(x => x.bookingid);",
                  "pm.test('El resultado incluye el booking creado', () => {",
                  "    pm.expect(ids).to.include(Number(pm.environment.get('bookingId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC-08 Actualizar booking completo (PUT con token)",
